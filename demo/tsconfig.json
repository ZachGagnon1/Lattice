{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": ["vite/client", "node"],
    "allowJs": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "paths": {
      "@demo": ["./src"],
      "@demo/*": ["./src/*"],
      "@": ["../packages/lattice/src"],
      "@/*": ["../packages/lattice/src/*"],
      "lattice": ["../packages/lattice/src/index.tsx"]
    }
  },
  "include": [
    "./src",
    "./example",
    "./typings",
    "../packages/lattice/src/typings/mjml-browser.ts"
  ],
  "exclude": ["node_modules"]
}
