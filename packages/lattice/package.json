{
  "name": "lattice-editor",
  "license": "MIT",
  "description": "Lattice is a feature-rich, open-source SaaS email editor based on React and MJML.",
  "version": "1.0.0-beta.1",
  "author": "ZachGagnon1",
  "repository": {
    "type": "git",
    "url": "git@github.com:ZachGagnon1/Lattice.git"
  },
  "keywords": [
    "email editor core"
  ],
  "files": [
    "lib"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js"
    },
    "./handlebars": {
      "types": "./lib/handlebars.d.ts",
      "import": "./lib/handlebars.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "typings": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build": "rimraf lib && npm run typings && vite build --config vite.config.ts",
    "format": "eslint --fix  --ext .tsx,.ts,.tsx src/",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,scss}",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "husky": {
    "hooks": {
      "pre-commit": "yarn test && yarn lint-staged"
    }
  },
  "lint-staged": {
    "src/*.{js,jsx,ts,tsx}, example/*.{js,jsx,ts,tsx}": [
      "yarn lint"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/view": "^6.43.13",
    "@dnd-kit/react": "^0.4.0",
    "@emotion/cache": "^11.14.0",
    "@fontsource/roboto": "^5.2.10",
    "@uiw/codemirror-theme-material": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.1.1",
    "add": "^2.0.6",
    "cheerio": "^1.2.0",
    "codemirror": "^6.0.2",
    "color": "^5.0.3",
    "he": "^1.2.0",
    "is-hotkey": "^0.2.0",
    "js-beautify": "^1.15.4",
    "lodash": "4.18.1",
    "mjml-browser": "^5.4.1",
    "overlayscrollbars": "^2.15.1",
    "overlayscrollbars-react": "^0.5.6",
    "react-colorful": "^5.8.1",
    "react-hook-form": "^7.88.0",
    "react-is": "18.2.0",
    "react-use": "^17.6.1",
    "use-debounce": "^10.1.1",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@types/color": "^4.2.1",
    "@types/he": "^1.2.3",
    "@types/is-hotkey": "^0.1.10",
    "@types/js-beautify": "^1.14.3",
    "@types/jsdom": "^28.0.1",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "esbuild": "^0.28.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "handlebars": "^4.7.9",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "sass": "^1.105.0",
    "tsc-alias": "^1.9.5",
    "typescript": "^6.0.3",
    "vite": "8.3.1",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.4.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@mui/x-tree-view": "^9.0.4",
    "handlebars": "^4.7.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "handlebars": {
      "optional": true
    }
  },
  "gitHead": "2a08e8af15766344de708d891c1c8ea31bb77646"
}
